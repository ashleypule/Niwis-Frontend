# mock = Mock Service Worker answers /api/v1/* with seeded sample data; api = real backend
VITE_DATA_SOURCE=mock
# Base URL of the NIWIS backend, e.g. https://niwis.dws.gov.za (used when VITE_DATA_SOURCE=api)
VITE_API_BASE_URL=
# Simulated latency for mock responses (ms)
VITE_MOCK_LATENCY_MS=300
# Pin the "data as of" date (ISO) so screenshots and tests are reproducible; defaults to now
# VITE_AS_OF=2026-10-09
