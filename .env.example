# Where data comes from:
#   mock   = Mock Service Worker answers /api/v1/* with seeded sample data (demos, offline work, tests)
#   hybrid = modules in VITE_LIVE_MODULES (plus /meta, /health, reference lists) from the backend; sample data for the rest
#   api    = everything from the backend (no mock worker)
# Leave empty to get hybrid when VITE_LIVE_MODULES is set, mock otherwise.
VITE_DATA_SOURCE=mock
# Modules the backend serves (hybrid mode)
VITE_LIVE_MODULES=rainfall,drought,climate,vegetation,runoff,dams,surface-water,groundwater,groundwater-reserve
# /meta/* and /health from the backend (hybrid mode)
VITE_LIVE_META=true
# Backend origin for production builds, e.g. https://niwis.dws.gov.za. Leave empty in development: the Vite proxy forwards /api.
VITE_API_BASE_URL=
# Target of the dev / preview proxy for /api
VITE_API_PROXY_TARGET=http://localhost:8000
# What a panel shows when the backend has no data for it (501 DATA_UNAVAILABLE):
#   sample = the sample data, clearly marked (default in development); empty = "Not yet available" (default in production builds)
# VITE_UNAVAILABLE_MODE=sample
# Marker text for backend data, e.g. "Database" until the data team confirms the values are measured
VITE_LIVE_LABEL=Live
# Simulated latency for mock responses (ms)
VITE_MOCK_LATENCY_MS=300
# Pin the "data as of" date (ISO) so screenshots and tests are reproducible; defaults to now
# VITE_AS_OF=2026-10-09
