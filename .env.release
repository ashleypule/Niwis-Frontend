# `npm run build:release` / `vite build --mode release`: the production build. Everything comes from the NIWIS API
# (no Mock Service Worker, so no sample data can appear); panels the database cannot serve show "Not yet available"
# with the reason the API gives (501 DATA_UNAVAILABLE).
VITE_DATA_SOURCE=api
# Same origin: nginx serves the app and proxies /api to the API container. Set an origin only if the API is elsewhere.
VITE_API_BASE_URL=
VITE_LIVE_LABEL=Live
VITE_LIVE_META=true
VITE_UNAVAILABLE_MODE=empty
